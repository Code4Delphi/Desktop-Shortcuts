package DesktopShortcuts;

{$R *.res}
{$DESCRIPTION 'Atalhos para alternar os Desktops do RAD Studio'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  designide;

contains
  DesktopShortcuts.Settings in 'DesktopShortcuts.Settings.pas',
  DesktopShortcuts.Form in 'DesktopShortcuts.Form.pas' {DesktopShortcutsForm},
  DesktopShortcuts.Wizard in 'DesktopShortcuts.Wizard.pas';

end.
